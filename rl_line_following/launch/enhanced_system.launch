<?xml version="1.0"?>
<launch>
    <!-- 启动Gazebo和机器人模型 -->
    <include file="$(find robot_gazebo)/launch/gazebo_demo.launch" />
    
    <!-- 启动Rviz -->
    <node name="rviz" pkg="rviz" type="rviz" 
          args="-d $(find rl_line_following)/rviz/path_following.rviz" 
          required="true"/>
    
    <!-- 加载地图 -->
    <arg name="map_file" default="$(find rl_line_following)/maps/my_map.yaml"/>
    <node name="map_server" pkg="map_server" type="map_server" args="$(arg map_file)" />
    
    <!-- 发布静态坐标系转换 -->
    <node pkg="tf" type="static_transform_publisher" name="map_to_odom"
          args="0 0 0 0 0 0 map odom 100" />
    
    <!-- 启动路径规划器 -->
    <node pkg="rl_line_following" type="rviz_path_planner.py" 
          name="rviz_path_planner" output="screen"/>
    
    <!-- 路径平滑器（可选） -->
    <node pkg="rl_line_following" type="path_smoother.py" 
          name="path_smoother" output="screen">
        <param name="smoothing_factor" value="0.3"/>
    </node>
    
    <!-- 选择路径跟踪器版本 -->
    <arg name="use_enhanced_tracker" default="true"/>
    
    <group if="$(arg use_enhanced_tracker)">
        <!-- 增强版路径跟踪器（带障碍物避障和速度规划） -->
        <node pkg="rl_line_following" type="path_tracker_with_obstacle_avoidance.py" 
              name="path_tracker" output="screen">
            <param name="max_linear_speed" value="1.2"/>
            <param name="max_angular_speed" value="2.5"/>
            <param name="obstacle_threshold" value="0.5"/>
            <param name="avoidance_angle" value="30.0"/>
            <param name="max_acceleration" value="0.5"/>
            <param name="max_deceleration" value="0.8"/>
        </node>
    </group>
    
    <group unless="$(arg use_enhanced_tracker)">
        <!-- 标准路径跟踪器 -->
        <node pkg="rl_line_following" type="path_tracker.py" 
              name="path_tracker" output="screen"/>
    </group>
    
    <!-- 轨迹记录器 -->
    <node pkg="rl_line_following" type="trajectory_recorder.py" 
          name="trajectory_recorder" output="screen"/>
    
    <!-- 添加第二辆小车（在第一辆车正后方1米） -->
    <param name="robot2_description" command="$(find xacro)/xacro $(find robot_gazebo)/urdf/pav_s00/pav_s00.xacro robot_name:=robot2"/>
    
    <node name="spawn_robot2" pkg="gazebo_ros" type="spawn_model" output="screen"
          args="-param robot2_description
                -urdf
                -model robot2
                -x 1.0
                -y -0.7
                -z 0.1
                -Y 3.14
                "/>
    
    <!-- 第二辆车的robot_state_publisher -->
    <node name="robot2_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" output="screen">
        <remap from="robot_description" to="robot2_description"/>
        <remap from="joint_states" to="/robot2/joint_states"/>
    </node>
    
    <!-- 跟随机器人控制器（预测性跟随） -->
    <node pkg="rl_line_following" type="follower_robot.py" 
          name="follower_robot" output="screen">
        <param name="follow_distance" value="1.0"/>
        <param name="max_linear_speed" value="1.2"/>
        <param name="max_angular_speed" value="2.5"/>
        <param name="leader_odom_topic" value="/odom"/>
        <param name="follower_odom_topic" value="/robot2/odom"/>
        <param name="follower_cmd_topic" value="/robot2/cmd_vel"/>
    </node>
    
    <!-- 启动摄像头查看器 -->
    <node pkg="rl_line_following" type="camera_viewer.py" 
          name="camera_viewer" output="screen">
        <remap from="/depth_camera/rgb/image_raw" to="/depth_camera/rgb/image_raw"/>
        <remap from="/depth_camera/depth/image_raw" to="/depth_camera/depth/image_raw"/>
    </node>
    
    <!-- 可视化增强器 -->
    <node pkg="rl_line_following" type="visualization_enhancer.py" 
          name="visualization_enhancer" output="screen"/>
    
    <!-- 设置日志级别 -->
    <env name="ROSCONSOLE_CONFIG_FILE" 
         value="$(find rl_line_following)/config/rosconsole.conf"/>
    
</launch>

